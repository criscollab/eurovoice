// Prisma schema for Euro Voice - Multi-station online radio platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Station {
  id          String   @id @default(cuid())
  name        String
  description String?
  language    String   @default("Español")
  color       String   @default("#3b82f6") // blue accent color (hex)
  coverUrl    String?
  order       Int      @default(0) // for custom ordering in the UI
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  songs       Song[]
}

model Song {
  id          String   @id @default(cuid())
  title       String
  artist      String
  audioUrl    String   @default("") // kept for backwards compat; no longer required for YouTube embed mode
  duration    Int      @default(180) // duration in seconds
  coverUrl    String?
  // Required YouTube URL — Euro Voice now uses YouTube embed mode for legal
  // playback of any song (commercial or CC). The video plays directly from
  // YouTube, so artists get their views and no copyright is infringed.
  youtubeUrl  String
  order       Int      @default(0)
  playCount   Int      @default(0) // how many times this song has been played
  // Reaction counts — denormalized for fast reads. SongReaction rows are the
  // source of truth; these counters are kept in sync by the react endpoint.
  likes       Int      @default(0)
  hearts      Int      @default(0)
  dislikes    Int      @default(0)
  stationId   String
  station     Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)
  reactions   SongReaction[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([stationId, order])
  @@index([playCount]) // for top-songs query
  @@index([likes])
  @@index([hearts])
  @@index([dislikes])
}

/**
 * SongReaction
 * Stores a single reaction (like | heart | dislike) from one anonymous session
 * to one song. The (sessionId, songId) pair is unique: each session can have
 * at most one reaction per song. Changing the reaction just updates the row.
 */
model SongReaction {
  id         String   @id @default(cuid())
  sessionId  String
  songId     String
  reaction   String   // 'like' | 'heart' | 'dislike'
  song       Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([sessionId, songId])
  @@index([songId, reaction])
}

/**
 * ListenerSession
 * Tracks a unique listener browser session. Used to count "current listeners"
 * (sessions active in the last 60 seconds) and historical stats.
 *
 * A new row is created the first time a browser connects. Subsequent heartbeats
 * just update `lastSeenAt`. Sessions older than 60 seconds are considered
 * "offline" but kept for historical stats.
 */
model ListenerSession {
  id          String   @id @default(cuid())
  // A random ID generated client-side and stored in localStorage. Lets us
  // recognize the same browser across visits without requiring login.
  sessionId   String   @unique
  // The station the listener is currently tuned to (null if none)
  stationId   String?
  // The country code detected from IP (e.g. "CO", "US", "LV"). Null if undetected.
  country     String?
  // The user-agent string of the browser (truncated for storage)
  userAgent   String?
  firstSeenAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([lastSeenAt])
  @@index([stationId])
}
